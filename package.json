{
  "name": "nbook",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:firestore": "firebase emulators:exec --only firestore --project demo-nbook \"vitest run src/lib/storage/firestore.emulator.test.ts\"",
    "pretest:e2e": "rm -rf .nbook-e2e",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "verify:all": "npm run verify && npm run test:firestore && npm run test:e2e"
  },
