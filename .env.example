# ---------------------------------------------------------------------------
# NBOOK environment variables
#
# Copy to `.env.local` (git-ignored) and fill in what you need.
# Nothing here is required for `npm run dev` — with no Firebase credentials
# the app falls back to the local JSON storage driver and the AI panel reports
# "not configured".
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------

# Absolute URL of the deployment. Used for OpenRouter HTTP-Referer headers and
# for building self-referential links. Defaults to http://localhost:3000
APP_URL="http://localhost:3000"

# Secret used to sign the HMAC on the notebook session cookie.
# REQUIRED in production (`npm run build && npm start`); the app refuses to
# start in production without one. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
# Alias accepted in place of SESSION_SECRET.
NBOOK_SESSION_SECRET=""

# --- Storage -----------------------------------------------------------------
#
# Firebase credentials are optional. If none are present the app uses the
# local JSON driver (see NBOOK_LOCAL_DATA_DIR) — perfect for development.
# Set any one of FIREBASE_SERVICE_ACCOUNT / GOOGLE_APPLICATION_CREDENTIALS /
# FIREBASE_PROJECT_ID / FIRESTORE_EMULATOR_HOST to switch to Firestore.

# JSON key for a Firebase service account (single line, quoted).
FIREBASE_SERVICE_ACCOUNT=""
# Path to a service-account JSON file instead of inlining it.
GOOGLE_APPLICATION_CREDENTIALS=""
FIREBASE_PROJECT_ID=""
# Storage bucket for uploaded media (`<project>.appspot.com` by default).
FIREBASE_STORAGE_BUCKET=""
# Point at a local emulator; also honours GCLOUD_PROJECT.
FIRESTORE_EMULATOR_HOST=""

# Directory for the local JSON driver. Defaults to `./.nbook-data`.
NBOOK_LOCAL_DATA_DIR="./.nbook-data"

# --- AI ----------------------------------------------------------------------
#
# Fallback order: Groq → Cerebras → OpenRouter. Set at least one key to enable
# the Assist panel; with none set the /api/ai route returns 503 and the UI
# shows a friendly "not configured" message. A provider whose key is unset is
# skipped. The default models are free-tier models for each provider.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
CEREBRAS_API_KEY=""
CEREBRAS_MODEL="gpt-oss-120b"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nvidia/nemotron-3-super-120b-a12b:free"
# Endpoint overrides (tests / corporate proxy only — never set in production):
# GROQ_BASE_URL, CEREBRAS_BASE_URL, OPENROUTER_BASE_URL
