rules_version = '2';

// Deny-all by design: the browser never talks to Firestore. Every read and
// write goes through the Next.js API, which uses firebase-admin — and the
// Admin SDK bypasses these rules (it authenticates as the emulator owner).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
